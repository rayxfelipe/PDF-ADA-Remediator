{
  "rules": [
    {
      "enabled": true,
      "name": "DeletePdfJobsAfterOneDay",
      "type": "Lifecycle",
      "definition": {
        "actions": {
          "baseBlob": {
            "delete": {
              "daysAfterModificationGreaterThan": 1
            }
          }
        },
        "filters": {
          "blobTypes": [
            "blockBlob"
          ],
          "prefixMatch": [
            "pdf-jobs/"
          ]
        }
      }
    }
  ]
}
